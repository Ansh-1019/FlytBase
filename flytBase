"    \"waterlogging_or_flood\",\n","    \"wrong_way_driving\",\n","    \"vehicle_blocking_traffic\",\n","]\n","\n","# Put model in inference mode\n","model.eval()\n","\n","# Disable training-only memory features\n","try:\n","    model.gradient_checkpointing_disable()\n","except:\n","    pass\n","\n","model.config.use_cache = True\n","\n","# --------------------------------------------------\n","# CLASSIFICATION PROMPT\n","# --------------------------------------------------\n","\n","INFERENCE_PROMPT = f\"\"\"You are reviewing a short drone video clip, shown as a 3x3 grid\n","of frames sampled evenly across the clip (left-to-right, top-to-bottom;\n","frame 1 is the start of the clip, frame 9 is near the end).\n","\n","Classify the video into exactly one of these categories:\n","\n","{\", \".join(VALID_CLASSES)}\n","\n","Return ONLY this JSON and nothing else:\n","\n","{{\"is_anomaly\": true or false, \"class_name\": \"<one of the categories above>\"}}\n","\"\"\"\n","\n","\n","# --------------------------------------------------\n","# MODEL INFERENCE\n","# --------------------------------------------------\n","\n","def run_qwen_inference(grid):\n","\n","    messages = [{\n","        \"role\": \"user\",\n","        \"content\": [\n","            {\n","                \"type\": \"image\",\n","                \"image\": grid\n","            },\n","            {\n","                \"type\": \"text\",\n","                \"text\": INFERENCE_PROMPT\n","            }\n","        ]\n","    }]\n","\n","    prompt_text = processor.apply_chat_template(\n","        messages,\n","        tokenize=False,\n","        add_generation_prompt=True\n","    )\n","\n","    inputs = processor(\n","        text=[prompt_text],\n","        images=[grid],\n","        return_tensors=\"pt\"\n","    )\n","\n","    # Move tensors to model device\n","    inputs = {\n","        k: v.to(model.device) if hasattr(v, \"to\") else v\n","        for k, v in inputs.items()\n","    }\n","\n","    with torch.inference_mode():\n","\n","        output_ids = model.generate(\n","            **inputs,\n","            max_new_tokens=40,\n","            do_sample=False\n","        )\n","\n","    # Decode only newly generated tokens\n","    input_len = inputs[\"input_ids\"].shape[1]\n","\n","    generated_ids = output_ids[:, input_len:]\n","\n","    response = processor.batch_decode(\n","        generated_ids,\n","        skip_special_tokens=True\n","    )[0].strip()\n","\n","    return response\n","\n","\n","# --------------------------------------------------\n","# JSON PARSER\n","# --------------------------------------------------\n","\n","def parse_prediction(response):\n","\n","    # Try direct JSON\n","    try:\n","        data = json.loads(response)\n","        return data\n","    except:\n","        pass\n","\n","    # Try extracting JSON from surrounding text\n","    match = re.search(r'\\{.*\\}', response, re.DOTALL)\n","\n","    if match:\n","        try:\n","            return json.loads(match.group())\n","        except:\n","            pass\n","\n","    # If model output is malformed, safely classify as normal\n","    return {\n","        \"is_anomaly\": False,\n","        \"class_name\": \"normal\"\n","    }\n","\n","\n","# --------------------------------------------------\n","# EXPLANATIONS\n","# --------------------------------------------------\n","\n","EXPLANATIONS = {\n","    \"fighting_or_violence\":\n","        \"The video shows visual evidence consistent with fighting or violent activity.\",\n","\n","    \"loitering_or_suspicious_presence\":\n","        \"The video shows a person or group exhibiting suspicious or prolonged presence.\",\n","\n","    \"fire\":\n","        \"The video shows visual evidence consistent with a fire incident.\",\n","\n","    \"road_spill_or_debris\":\n","        \"The video shows material or debris present on the roadway.\",\n","\n","    \"smoke\":\n","        \"The video shows visible smoke in the observed scene.\",\n","\n","    \"stalled_or_broken_down_vehicle\":\n","        \"The video shows a vehicle that appears stationary due to a breakdown or stoppage.\",\n","\n","    \"traffic_accident\":\n","        \"The video shows visual evidence consistent with a traffic accident.\",\n","\n","    \"traffic_congestion\":\n","        \"The video shows unusually dense or slow-moving traffic.\",\n","\n","    \"waterlogging_or_flood\":\n","        \"The video shows water accumulation or flooding affecting the observed area.\",\n","\n","    \"wrong_way_driving\":\n","        \"The video shows a vehicle apparently traveling against the expected traffic direction.\",\n","\n","    \"vehicle_blocking_traffic\":\n","        \"The video shows a vehicle obstructing an active traffic lane or roadway.\"\n","}\n","\n","\n","# --------------------------------------------------\n","# PROCESS ALL TEST VIDEOS\n","# --------------------------------------------------\n","\n","submission = []\n","\n","overall_start = time.perf_counter()\n","\n","for _, row in tqdm(\n","    test_df.iterrows(),\n","    total=len(test_df),\n","    desc=\"Running inference\"\n","):\n","\n","    video_start = time.perf_counter()\n","\n","    video_path = row[\"video_path\"]\n","\n","    # Extract 9 temporal frames\n","    frames = extract_frames(video_path, n=9)\n","\n","    if len(frames) == 0:\n","\n","        video_id = (\n","            row[\"video_id\"]\n","            if \"video_id\" in row\n","            else os.path.splitext(os.path.basename(row[\"filename\"]))[0]\n","        )\n","\n","        submission.append({\n","            \"video_id\": video_id,\n","            \"events\": [],\n","            \"runtime_metadata\": {\n","                \"frames_processed\": 0,\n","                \"chunks_processed\": 0,\n","                \"end_to_end_internal_time_ms\": 0,\n","                \"model_runtimes\": []\n","            }\n","        })\n","\n","        continue\n","\n","    # Create 3x3 temporal grid\n","    grid = make_grid(frames)\n","\n","    # Measure model runtime\n","    model_start = time.perf_counter()\n","\n","    response = run_qwen_inference(grid)\n","\n","    model_time_ms = (\n","        time.perf_counter() - model_start\n","    ) * 1000\n","\n","    # Parse model response\n","    prediction = parse_prediction(response)\n","\n","    is_anomaly = bool(\n","        prediction.get(\"is_anomaly\", False)\n","    )\n","\n","    class_name = prediction.get(\n","        \"class_name\",\n","        \"normal\"\n","    )\n","\n","    # Validate class\n","    if class_name not in VALID_CLASSES:\n","        class_name = \"normal\"\n","        is_anomaly = False\n","\n","    # Normal videos must have NO events\n","    if class_name == \"normal\":\n","        is_anomaly = False\n","\n","    # Video ID\n","    if \"video_id\" in test_df.columns:\n","        video_id = str(row[\"video_id\"])\n","    elif \"id\" in test_df.columns:\n","        video_id = str(row[\"id\"])\n","    else:\n","        video_id = os.path.splitext(\n","            os.path.basename(row[\"filename\"])\n","        )[0]\n","\n","    # --------------------------------------------------\n","    # CREATE EVENTS\n","    # --------------------------------------------------\n","\n","    if is_anomaly:\n","\n","        event = {\n","            \"class_name\": class_name,\n","\n","            # Difficulty 1 allows null temporal values\n","            \"start_time_sec\": None,\n","            \"end_time_sec\": None,\n","\n","            \"explanation\": EXPLANATIONS.get(\n","                class_name,\n","                f\"The video shows visual evidence consistent with {class_name.replace('_', ' ')}.\"\n","            )\n","        }\n","\n","        events = [event]\n","\n","    else:\n","        events = []\n","\n","    # End-to-end processing time\n","    total_video_time_ms = (\n","        time.perf_counter() - video_start\n","    ) * 1000\n","\n","    result = {\n","        \"video_id\": video_id,\n","        \"events\": events,\n","\n","        \"runtime_metadata\": {\n","            \"frames_processed\": len(frames),\n","            \"chunks_processed\": 1,\n","            \"end_to_end_internal_time_ms\": round(\n","                total_video_time_ms,\n","                2\n","            ),\n","\n","            \"model_runtimes\": [\n","                {\n","                    \"model_name\": \"Qwen2.5-VL-3B-Instruct-LoRA\",\n","                    \"call_count\": 1,\n","                    \"total_time_ms\": round(\n","                        model_time_ms,\n","                        2\n","                    ),\n","                    \"average_time_ms\": round(\n","                        model_time_ms,\n","                        2\n","                    ),\n","                    \"p50_time_ms\": round(\n","                        model_time_ms,\n","                        2\n","                    ),\n","                    \"p95_time_ms\": round(\n","                        model_time_ms,\n","                        2\n","                    ),\n","                    \"max_time_ms\": round(\n","                        model_time_ms,\n","                        2\n","                    )\n","                }\n","            ]\n","        }\n","    }\n","\n","    submission.append(result)\n","\n","    # Free temporary tensors\n","    del grid\n","\n","    if torch.cuda.is_available():\n","        torch.cuda.empty_cache()\n","\n","\n","overall_time_ms = (\n","    time.perf_counter() - overall_start\n",") * 1000\n","\n","\n","print(\"\\n========================================\")\n","print(\"✅ INFERENCE COMPLETE\")\n","print(\"========================================\")\n","print(\"Videos processed:\", len(submission))\n","print(\"Total wall time:\", round(overall_time_ms, 2), \"ms\")\n","\n","anomalies = sum(\n","    1 for x in submission\n","    if len(x[\"events\"]) > 0\n",")\n","\n","normal = len(submission) - anomalies\n","\n","print(\"Anomalies:\", anoma