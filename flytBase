","        row = self.df.iloc[idx]\n","\n","        frames = extract_frames(\n","            row[\"video_path\"],\n","            n=9\n","        )\n","\n","        if frames:\n","            grid = make_grid(frames)\n","        else:\n","            grid = Image.new(\"RGB\", (840, 474))\n","\n","        return {\n","            \"image\": grid,\n","            \"prompt\": PROMPT_TEMPLATE,\n","            \"target\": row_to_target_json(row)\n","        }\n","\n","train_dataset = AnomalyDataset(train_df)\n","\n","print(\"Dataset created!\")\n","print(\"Samples:\", len(train_dataset))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"1_mU_gINMx8p","executionInfo":{"status":"ok","timestamp":1788605631272,"user_tz":-330,"elapsed":48,"user":{"displayName":"07_Ansh Jaiswal","userId":"07747807337499758038"}},"outputId":"b1bb76b9-5ea3-470a-d869-4c61dee20aba"},"execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["Dataset created!\n","Samples: 3173\n"]}]},{"cell_type":"code","source":["import cv2\n","import numpy as np\n","from PIL import Image\n","\n","def extract_frames(video_path, n=9):\n","    cap = cv2.VideoCapture(video_path)\n","\n","    total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n","\n","    if total <= 0:\n","        cap.release()\n","        return []\n","\n","    idxs = np.linspace(\n","        0,\n","        total - 1,\n","        n\n","    ).astype(int)\n","\n","    frames = []\n","\n","    for i in idxs:\n","        cap.set(cv2.CAP_PROP_POS_FRAMES, int(i))\n","\n","        ret, frame = cap.read()\n","\n","        if ret:\n","            frame = cv2.cvtColor(\n","                frame,\n","                cv2.COLOR_BGR2RGB\n","            )\n","\n","            frames.append(\n","                Image.fromarray(frame)\n","            )\n","\n","    cap.release()\n","\n","    return frames\n","\n","\n","def make_grid(\n","    frames,\n","    grid_size=3,\n","    cell_size=(280, 158)\n","):\n","    frames = [\n","    